---
// DOCS-patch-notes-from-history Step 1 — /updates/, the monthly patch notes.
//
// One Markdown file per month under `content/updates/`, written by hand from the
// month's merged PRs (procedure: README § 패치 노트) and approved by the owner before
// it ships. Newest first. Static: nothing here reads a session or an API.
import Layout from '@layouts/layout.astro'
import Seo from '@components/seo.astro'
import SkipNavContent from '@components/a11y/skip-nav-content.astro'
import { getCollection, render } from 'astro:content'

export const prerender = true

// Same publish date (the first release ships two entries at once) falls back to the
// file id, which sorts by month: `2026-10` before `2026-07-09`.
const entries = (await getCollection('updates')).sort(
	(a, b) =>
		b.data.published.getTime() - a.data.published.getTime() ||
		b.id.localeCompare(a.id),
)
const rendered = await Promise.all(
	entries.map(async entry => ({ entry, Content: (await render(entry)).Content })),
)
---

<Layout>
	<Seo
		slot="seo"
		forceTitle="업데이트"
		description="buckit에서 무엇이 바뀌었고 왜 바꿨는지 — 방문자와 회원이 알아챌 만한 변화를 달마다 정리합니다."
	/>
	<SkipNavContent>
		<main class="up-wrap">
			<header class="up-head">
				<p class="kicker">업데이트</p>
				<h1 class="up-title">무엇이 바뀌었나요</h1>
				<p class="up-dek">
					사이트에서 눈에 띄는 변화와 그 이유를 달마다 정리합니다. 항목 끝의 링크는 실제 변경 기록(GitHub)입니다.
				</p>
			</header>

			{rendered.map(({ entry, Content }) => (
				<article class="up-entry" id={entry.id}>
					<header class="up-entry-head">
						<h2 class="up-entry-title">{entry.data.title}</h2>
						<p class="up-period">{entry.data.period}</p>
						<p class="up-summary">{entry.data.summary}</p>
					</header>
					<div class="up-body">
						<Content />
					</div>
				</article>
			))}
		</main>
	</SkipNavContent>
</Layout>

<style>
	.up-wrap {
		max-width: 720px;
		margin: 0 auto;
		padding: 56px 20px 96px;
	}
	.up-head {
		margin-bottom: 34px;
	}
	.up-title {
		font-family: var(--font-serif);
		font-size: clamp(28px, 5vw, 40px);
		line-height: 1.2;
		margin: 6px 0 14px;
	}
	.up-dek {
		font-family: var(--font-sans);
		font-size: 14.5px;
		line-height: 1.7;
		color: var(--color-subtle);
		margin: 0;
	}
	.up-entry {
		padding: 28px 0 8px;
		border-top: 1px solid var(--color-border);
	}
	.up-entry + .up-entry {
		margin-top: 24px;
	}
	.up-entry-title {
		font-family: var(--font-serif);
		font-size: 24px;
		line-height: 1.3;
		margin: 0;
	}
	.up-period {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.03em;
		color: var(--color-faded);
		margin: 6px 0 0;
	}
	.up-summary {
		font-family: var(--font-sans);
		font-size: 14.5px;
		line-height: 1.7;
		color: var(--color-text);
		margin: 12px 0 0;
	}

	/* Rendered Markdown: one `###` per item, prose under it, PR links in <small>. */
	.up-body :global(h3) {
		font-family: var(--font-serif);
		font-size: 17px;
		font-weight: 500;
		color: var(--color-text);
		margin: 0;
		padding-top: 16px;
		border-top: 1px solid var(--color-border-soft);
	}
	.up-body :global(h3:first-child) {
		margin-top: 20px;
	}
	.up-body :global(p) {
		font-family: var(--font-sans);
		font-size: 13.5px;
		line-height: 1.7;
		color: var(--color-subtle);
		margin: 8px 0 0;
		overflow-wrap: anywhere;
	}
	.up-body :global(p + h3) {
		margin-top: 18px;
	}
	.up-body :global(strong) {
		color: var(--color-text);
		font-weight: 500;
	}
	.up-body :global(small) {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.02em;
		color: var(--color-faded);
	}
	.up-body :global(a) {
		color: var(--color-accent);
	}
	.up-body :global(small a) {
		color: var(--color-faded);
		white-space: nowrap;
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.up-body :global(small a:hover) {
		color: var(--color-text);
	}
</style>
