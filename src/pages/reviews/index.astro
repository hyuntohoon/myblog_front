---
import Layout from '@layouts/layout.astro'
import Seo from '@components/seo.astro'
import SkipNavContent from '@components/a11y/skip-nav-content.astro'
import ReviewsIndex from '@components/reviews/ReviewsIndex'
import { getCollection } from 'astro:content'
import { buildReviewCards } from '@lib/reviews'
import '@styles/reviews.css'

// /reviews — editorial "design C" layout: an oversized featured hero over a
// 3-column big-cover grid, with the same interactive filters/sort/search.
const reviews = buildReviewCards(await getCollection('blog'))
---

<Layout>
  <Seo slot="seo" title="Reviews" />

  <SkipNavContent>
    <div class="container">
      <!-- Masthead -->
      <header class="rev-masthead">
        <h1 class="rev-title">Reviews</h1>
      </header>

      <!--
        FEAT-album-review-authoring 충돌 #1. Two things were wrong in the empty
        state below. The word: 리뷰 is banned for both concepts (평론 = review,
        평가 = rating). And the CTA: this is a PUBLIC page and 평론 is editors-only
        (하드 룰 1), so "첫 리뷰를 작성해 보세요" invited every visitor to do the one
        thing they cannot do. The replacement matches EditorialHome's own empty
        state, which already says this correctly.
      -->
      {reviews.length === 0 ?
(
        <div class="rev-empty">
          <p class="rev-empty-title">아직 발행된 평론이 없습니다</p>
          <p class="rev-empty-sub">첫 평론이 이 자리에 실립니다.</p>
        </div>
      ) :
(
        <ReviewsIndex client:load reviews={reviews} variant="editorial" />
      )}
    </div>
  </SkipNavContent>
</Layout>
