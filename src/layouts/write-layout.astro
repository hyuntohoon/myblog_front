---
// FEAT-member-player Step 5b — the editor rejoins the site shell.
//
// This layout used to carry no `ClientRouter`, which made every /write ↔ site
// move a full document load. Step 5's in-page playback therefore stopped at the
// editor door: a document load tears down the whole JS context, so no swap
// override can save it.
//
// The reconciliation is deliberately narrow. `ClientRouter` must exist on BOTH
// sides or the router falls back to a document load, so it is the one thing that
// has to be added — plus the same playback-persist script `layout.astro` runs.
// The site header/footer, PocketBuckit and AlbumOverlay are still NOT mounted
// here: this is a full-screen editor, and pulling in the site chrome would be a
// product change wearing a refactor's clothes. Those islands simply do not
// persist onto /write (the incoming document has no counterpart), which is
// exactly today's behavior.
//
// Body stays class-less on purpose: `writer/base.css` owns the body rule here,
// and the swap takes body attributes from the incoming document, so
// `layout.astro`'s Tailwind body classes come off automatically on the way in
// and back on on the way out.
import { Font } from 'astro:assets'
import { ClientRouter } from 'astro:transitions'
import ThemeProvider from '@components/theme-provider.astro'

import '../styles/global.css'
// The ⌘K CommandPalette renders shared search atoms (ResultRow / .gs-*), whose
// styles live in search.css — incl. .gs-cover img { width/height: 100% }. Without
// this import the writer palette's covers render at full natural size (the artist
// drill-in photo fills the panel) and the rows lose their flex layout. The global
// /search, the header dropdown, and the member bucket modal already pull search.css in.
import '../styles/search.css'
import '../styles/writer.css'
import '../styles/research.css'
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-plex-sans" preload />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
	href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400;1,6..72,500;1,6..72,600&family=Noto+Serif+KR:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
	rel="stylesheet"
    />
    <ThemeProvider />
    <ClientRouter />
    <!--
      Same override layout.astro installs — inert unless this tab is the audio
      device, so on /write it costs nothing until the owner actually plays here.
    -->
    <script>
      import { installPlaybackPersist } from '../scripts/playbackPersist.client'

      installPlaybackPersist()
    </script>
    <slot name="seo" />
  </head>
  <body>
    <slot />
  </body>
</html>
